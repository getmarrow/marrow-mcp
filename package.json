{
  "name": "@getmarrow/mcp",
  "version": "3.9.100",
  "mcpName": "ai.getmarrow/marrow",
  "description": "Marrow AI MCP server: a named yes before your AI agent acts, and proof the next agent can reuse.",
  "bin": {
    "marrow-mcp": "dist/cli.js",
    "mcp": "dist/cli.js",
    "marrow-mcp-canary": "scripts/control-path-canary.cjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test --require ./test/support/isolated-environment.cjs test/*.test.js",
    "registry:check": "node scripts/mcp-registry-check.cjs",
    "npx:check": "node scripts/npx-executable-check.cjs",
    "registry:verify": "node scripts/mcp-registry-verify.cjs",
    "canary:control-path": "node scripts/control-path-canary.cjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "marrow-ai",
    "ai-agents",
    "agent-control-layer",
    "agent-approval",
    "human-in-the-loop",
    "approval-gate",
    "agent-governance",
    "audit-trail",
    "proof",
    "claude-code",
    "cursor",
    "codex",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmarrow/marrow-mcp.git"
  },
  "homepage": "https://getmarrow.ai/marrow-for-mcp",
  "bugs": {
    "url": "https://github.com/getmarrow/marrow-mcp/issues"
  },
  "marrow": {
    "category": "agent_fleet_governance_and_control_layer",
    "positioning": "agent_fleet_governance_and_control_layer",
    "role": "mcp-runtime-control-and-proof-server",
    "localSessionLoopGuard": "default-enabled for supported native hooks; private hashed state; explicit owner opt-out",
    "operatorApprovalRequired": true,
    "privacy": "No raw prompts, source code, credentials, or customer data are accepted by public discovery.",
    "governanceFit": "https://getmarrow.ai/.well-known/marrow.json",
    "evidence": "https://getmarrow.ai/.well-known/marrow-evidence.json",
    "referenceGraph": "https://getmarrow.ai/.well-known/marrow-reference-graph.json",
    "discovery": {
      "github": "https://api.getmarrow.ai/v1/public/discovery/placements/plc_ffa4b8ad5cee8dd9c9ec23dc",
      "npm": "https://api.getmarrow.ai/v1/public/discovery/placements/plc_bdf1abadff99a79182556248",
      "registry": "https://api.getmarrow.ai/v1/public/discovery/placements/plc_d3e06cb7675296dfd0c1021e"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "server.json",
    "scripts/mcp-registry-check.cjs",
    "scripts/mcp-registry-verify.cjs",
    "scripts/control-path-canary.cjs"
  ],
  "dependencies": {
    "@getmarrow/sdk": "^3.7.65"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.3.3"
  }
}
