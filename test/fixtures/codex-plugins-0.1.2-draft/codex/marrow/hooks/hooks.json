{
  "description": "Marrow hooks for Codex: the pinned @getmarrow/mcp Codex entrypoints that `npx @getmarrow/install` writes into .codex/hooks.json, in the same events. The tool matcher is `*`: every tool call, Marrow's own tools included, reaches the hook, and the hook decides. This plugin skips no tool by name. SessionStart installs the verified pinned copy once. Cooperative, client-reported control: they run only while this plugin is enabled and its hooks are trusted in Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/marrow-launch.cjs\" prepare",
            "timeout": 150
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/marrow-launch.cjs\" codex-context-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/marrow-launch.cjs\" codex-pre-action-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/marrow-launch.cjs\" codex-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/marrow-launch.cjs\" codex-session-hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
