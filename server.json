{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.getmarrow/marrow",
  "title": "Marrow AI: Control Layer for AI Agents",
  "description": "Approval gate and audit trail for AI agent actions: policy check first, proof after. Any MCP client.",
  "websiteUrl": "https://getmarrow.ai/marrow-for-mcp",
  "repository": {
    "url": "https://github.com/getmarrow/marrow-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://getmarrow.ai/brand/marrow-logo-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://getmarrow.ai/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "version": "3.9.108",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@getmarrow/mcp",
      "version": "3.9.108",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MARROW_API_KEY",
          "description": "Named Marrow agent API key. Keep it in trusted secret storage.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
